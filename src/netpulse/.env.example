# Optional settings; .env is not loaded automatically. No secrets belong in Git.
NETPULSE_API_URL=http://127.0.0.1:8000
NETPULSE_DB_PATH=data/netpulse.sqlite3
NETPULSE_CONFIG=targets.json
NETPULSE_AGENT_STATE_DIR=data/agent
# NETPULSE_UPLOAD_TOKEN: set securely in the process environment for a central HTTPS backend.
# Measurement configuration lives in targets.json (ignored); see targets.example.json.
